{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_RUN_PNPM_INSTALL": "1",
        "PNPM_FLAGS": "--no-frozen-lockfile",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    },
    "apk": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_RUN_PNPM_INSTALL": "1",
        "PNPM_FLAGS": "--no-frozen-lockfile",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      }
    }
  }
}
