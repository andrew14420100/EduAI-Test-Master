{
  "expo": {
    "name": "EduAI Test Master",
    "slug": "eduai-test-master",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eduai-test-master",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08111F"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.eduai.testmaster",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "exclude": [
                "META-INF/versions/9/OSGI-INF/MANIFEST.MF"
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiDomain": "https://eduai-test-master-backend.onrender.com",
      "clerkPublishableKey": "pk_test_dHJ1c3RlZC1xdWV0emFsLTk4NjMuY2xlcmsuYWNjb3VudHMuZGV2JA",
      "clerkProxyUrl": "",
      "eas": {
        "projectId": "29a57756-a3be-490c-ba3e-410d2ea15f7c"
      }
    }
  }
}
